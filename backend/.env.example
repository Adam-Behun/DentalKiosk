# Copy to backend/.env and fill in. Never commit the real file (.env is gitignored).

# MongoDB connection string. This default matches the mongo service in docker-compose.yml
# when the backend runs on the host (npm start).
MONGO_URI=mongodb://root:rootpassword@localhost:27017/dental_app?authSource=admin

# SMTP server used to email the MFA code (Nodemailer, STARTTLS-style: secure=false).
EMAIL_HOST=smtp.gmail.com
# SMTP port; 587 for STARTTLS.
EMAIL_PORT=587
# SMTP login; also used as the From address.
EMAIL_USER=your-email@example.com
# SMTP password (for Gmail, an app password, not your account password).
EMAIL_PASS=your-app-password

# Stripe secret key. Use a TEST mode key (sk_test_...) from the Stripe dashboard.
STRIPE_SECRET_KEY=sk_test_replace_me
# Signing secret for POST /webhook (whsec_..., printed by `stripe listen`).
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Port the API listens on (hosting platforms inject this; defaults to 4000).
PORT=4000
